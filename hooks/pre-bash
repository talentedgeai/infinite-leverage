#!/usr/bin/env bash
# PreToolUse hook: enforce Infinite Leverage git guardrails.
# Receives tool input via stdin as JSON: {"tool_name":"Bash","tool_input":{"command":"..."}}
# Exit 0 = allow. Output JSON with "decision":"block" to block.

set -euo pipefail

input="$(cat)"
command_str="$(echo "$input" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('command',''))" 2>/dev/null || echo "")"

block() {
  local reason="$1"
  printf '{"decision":"block","reason":"%s"}\n' "$reason"
  exit 0
}

# Blocked patterns
echo "$command_str" | grep -qE 'git push.*--force(-with-lease)?' && \
  block "Force-push is prohibited by Infinite Leverage guardrails (global-engineering.md). Use a PR instead."

echo "$command_str" | grep -qE 'git add(\s+-A|\s+\.)(\s|$)' && \
  block "git add -A / git add . is prohibited. Stage files explicitly by name."

echo "$command_str" | grep -qE -- '--no-verify' && \
  block "--no-verify skips hooks and is prohibited. Fix the hook failure instead."

echo "$command_str" | grep -qE 'git reset --hard' && \
  block "git reset --hard is a destructive operation. Confirm with the user first."

# Warn-only: direct push to main/master (not blocked, but surfaces a message)
if echo "$command_str" | grep -qE 'git push .*(origin\s+)?(main|master)(\s|$)'; then
  printf '{"decision":"allow","reason":"Warning: pushing directly to main/master. All changes should go through a PR per Infinite Leverage guardrails."}\n'
  exit 0
fi

exit 0
