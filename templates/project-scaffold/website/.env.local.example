# Copy to .env.local and fill in. Never commit .env.local itself.
#
# This file is the authoritative list — CI checks that every process.env.*
# the app reads appears here. If you add a new env var to the code, add it here
# in the same commit.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The URL and publishable key are public by design and
# are sent to the browser; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses row-level security — never expose it to the browser and
# never prefix it with NEXT_PUBLIC_. Required for billing writes (the Stripe
# webhook and the checkout route write `subscriptions`, which is SELECT-only to
# users on purpose).
SUPABASE_SECRET_KEY=sb_secret_...

# ── URLs ────────────────────────────────────────────────────────────────────
# SITE_URL is the public origin: auth email redirects and SEO metadata.
# APP_URL is where Stripe returns the user after checkout / billing portal.
# In production both are usually your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe (only if you use the billing routes) ─────────────────────────────
# Test keys start sk_test_ / whsec_. Get the webhook secret from
# dashboard.stripe.com/webhooks, or from `stripe listen` when developing.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
