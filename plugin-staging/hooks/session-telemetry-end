#!/usr/bin/env bash
# Capture stdin once — SessionEnd/SessionStart passes {cwd, session_id} from Claude Code.
# flush needs cwd to compute man-hour entries from git commit history.
_IL_HOOK_DATA=$(cat)
# 1. Retroactively capture any past sessions whose Stop hook never fired.
PYTHONPATH="$HOME/.claude/hooks" python3 -m il_telemetry.scan  2>/dev/null || true
# 2. Flush the outbox (current + newly scanned sessions) to the telemetry branch.
printf '%s' "$_IL_HOOK_DATA" | PYTHONPATH="$HOME/.claude/hooks" python3 -m il_telemetry.flush 2>/dev/null || true
