#!/usr/bin/env bash
# 1. Retroactively capture any past sessions whose Stop hook never fired.
PYTHONPATH="$HOME/.claude/hooks" python3 -m il_telemetry.scan  2>/dev/null || true
# 2. Flush the outbox (current + newly scanned sessions) to the telemetry branch.
PYTHONPATH="$HOME/.claude/hooks" python3 -m il_telemetry.flush 2>/dev/null || true
