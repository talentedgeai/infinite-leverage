#!/usr/bin/env bash
# Infinite Leverage — SessionStart hook (plugin repo edition)
# Four stages, all silent on pass. Never blocks the session.
#
# Stage 1  — initialization check (agents present?)
# Stage 2  — version check (template update available?)
# Stage 3  — context injection (routing rules)
# Stage 4  — usage awareness (token briefing into Claude's context)

# ── Stage 1: Initialization check ────────────────────────────────────────────
AGENTS_DIR="$HOME/.claude/agents"
if [ ! -d "$AGENTS_DIR" ] || [ -z "$(ls -A "$AGENTS_DIR" 2>/dev/null)" ]; then
    echo "[Infinite Leverage] Agents not found. Run /infiniteleverage-init to set up your 8-agent team."
fi

# ── Stage 2: Version check ───────────────────────────────────────────────────
# IL_TEMPLATE_REPO_URL is the raw VERSION file URL for the canonical template repo.
# Update this constant when the org/repo slug changes.
IL_TEMPLATE_REPO_URL="https://raw.githubusercontent.com/talentedgeai/infiniteleverage-8-agents-template/main/VERSION"
LOCAL_VERSION_FILE="$HOME/.claude/.infiniteleverage-version"

if [ -f "$LOCAL_VERSION_FILE" ]; then
    LOCAL_VERSION=$(cat "$LOCAL_VERSION_FILE" 2>/dev/null | tr -d '[:space:]')
    REMOTE_VERSION=$(curl -sf --max-time 3 "$IL_TEMPLATE_REPO_URL" 2>/dev/null | tr -d '[:space:]')
    if [ -n "$REMOTE_VERSION" ] && [ "$REMOTE_VERSION" != "$LOCAL_VERSION" ]; then
        echo "[Infinite Leverage] Template v${REMOTE_VERSION} available (you have v${LOCAL_VERSION}). Run /infiniteleverage-patch to update."
    fi
fi
# Network failure or missing local version → silent pass. Never degrade the session.

# ── Stage 3: Context injection ───────────────────────────────────────────────
# Agent routing rules are injected via CLAUDE.md (written during init).
# This stage is a no-op when the project CLAUDE.md contains the AGENT-DELEGATION block.
# If CLAUDE.md is absent, emit a brief routing summary so agents still route correctly.
if [ ! -f "CLAUDE.md" ] && [ ! -f "$HOME/.claude/CLAUDE.md" ]; then
    echo "[Infinite Leverage] No CLAUDE.md found. Agent routing is inactive. Run /infiniteleverage-init or add CLAUDE.md."
fi

# ── Stage 4: Usage awareness ─────────────────────────────────────────────────
python3 "$HOME/.claude/hooks/usage-context.py" 2>/dev/null || true

# ── Stage 5: Telemetry config guard ──────────────────────────────────────────
# Warn once (never block) if Claude session telemetry can't be delivered:
# no gh auth, or no git email to attribute the effort to.
if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1 || [ -z "$(git config user.email 2>/dev/null)" ]; then
    echo "[telemetry] not configured — effort not tracked; run /infiniteleverage-onboard"
fi

# ── Stage 5b: Registration notice ────────────────────────────────────────────
# If inside a git repo with a remote origin, check whether this repo is
# registered for effort tracking. Print a single line if not. Never blocks.
_IL_TRACKER_URL="${IL_TRACKER_URL:-https://human-token-tracker.vercel.app}"
_REPO_REMOTE=$(git config --get remote.origin.url 2>/dev/null || true)
if [ -n "$_REPO_REMOTE" ] && command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    _REPO_FULL=$(python3 - <<'PY' 2>/dev/null
import subprocess, sys
raw = subprocess.run(["git","config","--get","remote.origin.url"],
                    capture_output=True, text=True).stdout.strip()
s = raw
if s.endswith(".git"): s = s[:-4]
if ":" in s and "//" not in s:
    s = s.split(":",1)[1]
else:
    parts = s.split("//",1)[-1].split("/",1)
    s = parts[1] if len(parts)>1 else parts[0]
print(s.strip("/"))
PY
    )
    if [ -n "$_REPO_FULL" ]; then
        # Check local unregistered marker first (avoids network call)
        _SAFE_MARKER=$(echo "$_REPO_FULL" | sed 's|/|__|g')
        _MARKER_PATH="$HOME/.claude/.il-telemetry/unregistered/$_SAFE_MARKER"
        if [ -f "$_MARKER_PATH" ]; then
            : # already known unregistered — skip probe, no noise
        else
            _STATUS=$(python3 - "$_IL_TRACKER_URL" "$_REPO_FULL" <<'PY' 2>/dev/null
import sys, urllib.request, urllib.error, json
tracker, repo = sys.argv[1], sys.argv[2]
try:
    url = f"{tracker}/api/projects/status?repo={urllib.request.quote(repo, safe='/')}"
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent":"il-telemetry/1.0"}), timeout=5) as r:
        print("registered" if json.loads(r.read()).get("registered") else "unregistered")
except Exception:
    print("unknown")
PY
            )
            if [ "$_STATUS" = "unregistered" ]; then
                echo "[Infinite Leverage] This repo isn't tracked yet — ask me to \"register this project for effort tracking\" (or say skip)."
            fi
        fi
    fi
fi
